<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>safe_rl_nlpid</name>
  <version>1.0.0</version>
  <description>Safety-shielded reinforcement-learning tuning of a nonlinear PID (NLPID) heading and surge controller for autonomous surface vehicles, with a water-quality probe simulator.</description>
  <maintainer email="umar.alfa@imt-nord-europe.fr">Umar Alfa</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
